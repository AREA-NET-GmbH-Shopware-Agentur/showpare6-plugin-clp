<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="AreanetClp\Core\Content\AreanetClp\AreanetClpDefinition">
            <tag name="shopware.entity.definition" />
        </service>

        <service id="AreanetClp\Core\Content\AreanetClpGhs\AreanetClpGhsDefinition">
            <tag name="shopware.entity.definition" />
        </service>

        <service id="AreanetClp\Core\Content\Product\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="AreanetClp\Core\Content\AreanetClp\Aggregate\AreanetClpProduct\AreanetClpProductDefinition">
            <tag name="shopware.entity.definition" />
        </service>

        <service id="AreanetClp\Core\Content\AreanetClp\Aggregate\AreanetClpTranslation\AreanetClpTranslationDefinition">
            <tag name="shopware.entity.definition" />
        </service>

        <service id="AreanetClp\Core\Content\AreanetClpGhs\Aggregate\AreanetClpGhsTranslation\AreanetClpGhsTranslationDefinition">
            <tag name="shopware.entity.definition" />
        </service>

        <service id="AreanetClp\Core\Content\AreanetClp\Service\AreanetClpImportService" public="true">
            <argument type="service" id="language.repository" />
            <argument type="service" id="areanet_clp.repository" />
            <argument type="service" id="areanet_clp_ghs.repository" />
        </service>

        <service id="AreanetClp\Storefront\Page\Product\Subscriber\ProductPageCriteriaSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="AreanetClp\Core\Content\AreanetClp\Command\AreanetClpCommand">
            <argument type="service" id="AreanetClp\Core\Content\AreanetClp\Service\AreanetClpImportService"/>
            <tag name="console.command"/>
        </service>

    </services>
</container>