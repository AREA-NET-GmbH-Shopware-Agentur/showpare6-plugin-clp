export default "{% block sw_product_detail_base_settings_card %}\n    {% parent() %}\n\n    <sw-card :title=\"$t('sw-product.detail.areanetClpCardLabel')\"\n             :isLoading=\"isLoading\"\n             positionIdentifier=\"areanetClpCardLabel\"\n             v-if=\"(areanetClpSystemConfigValues.showAdminProductClpAssignment ?? false) === true\"\n    >\n        <my-custom-many-to-many-select\n                :localMode=\"product.isNew()\"\n                @change=\"getCustomFields\"\n                labelProperty=\"name\"\n                v-model=\"product.extensions.areanetClp\"\n                :placeholder=\"$t('sw-product.detail.areanetClpSelectPlaceholder')\"\n                :valueLimit=\"10\"\n                :label=\"$t('sw-product.detail.areanetClpSelectLabel')\"\n                :criteria=\"AreanetClpProductAssignmentCriteria\"\n        >\n\n            <template #selection-label-property=\"{ item }\">\n                <img\n                        v-if=\"item.ghs && item.ghs.image != null && item.ghs.image != ''\"\n                        :src=\"'../bundles/areanetclp/storefront/img/clp/' + item.ghs.image\"\n                        height=\"14\"\n                        style=\"height: 14px; float: left; padding-right: 5px;\"\n                />\n                {{ item.name }}\n            </template>\n\n            <template #result-label-property=\"{ item }\">\n                <img\n                        v-if=\"item.ghs && item.ghs.image != null && item.ghs.image != ''\"\n                        :src=\"'../bundles/areanetclp/storefront/img/clp/' + item.ghs.image\"\n                        width=\"40\"\n                />\n                {{ item.name }} - {{ item.text }}\n            </template>\n        </my-custom-many-to-many-select>\n\n        <sw-text-field\n                v-for=\"(field,key) in textFields\"\n                :key =\"key\"\n                v-model=\"product.customFields.areanet_clp[key]\">\n            <template slot=\"label\">\n                <span class=\"clp-label\">\n                    <img\n                            v-if=\"field.item.ghs && field.item.ghs.image != null && field.item.ghs.image != ''\"\n                            :src=\"'../bundles/areanetclp/storefront/img/clp/' + field.item.ghs.image\"\n                            width=\"40\"\n                    />\n                    <span v-else>&nbsp;</span>\n                    <b>{{ field.label }}:</b>\n                    <span>{{ field.text }}</span>\n                </span>\n            </template>\n        </sw-text-field>\n    </sw-card>\n{% endblock %}";