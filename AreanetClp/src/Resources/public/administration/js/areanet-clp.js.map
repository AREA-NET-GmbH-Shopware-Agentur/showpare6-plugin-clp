export default "{% block areanet_clp_detail %}\n    <sw-page class=\"areanet-clp-detail\">\n        <template slot=\"smart-bar-actions\">\n            <sw-language-switch\n                    @on-change=\"onChangeLanguage\"\n                    :saveChangesFunction=\"saveOnLanguageChange\"\n                    :disabled=\"!entityId\">\n            </sw-language-switch>\n\n            <sw-button :routerLink=\"{ name: 'areanet.clp.list' }\">\n                {{ $tc('areanet-clp.detail.cancelButtonText') }}\n            </sw-button>\n\n            <sw-button-process\n                    :isLoading=\"isLoading\"\n                    :processSuccess=\"processSuccess\"\n                    variant=\"primary\"\n                    @process-finish=\"saveFinish\"\n                    @click=\"onClickSave\">\n                {{ $tc('areanet-clp.detail.saveButtonText') }}\n            </sw-button-process>\n        </template>\n        <template slot=\"content\">\n            <sw-card-view>\n                <sw-card v-if=\"entity\" :isLoading=\"isLoading\" position-identifier=\"areanet-clp-form\">\n\n                    <sw-alert variant=\"warning\" appearance=\"default\" :title=\"$t('areanet-clp.detail.notChangeableAlertTitle')\" :showIcon=\"true\" :closable=\"false\" v-if=\"isDisabled\">\n                        {{ $t('areanet-clp.detail.notChangeableAlertText') }}\n                    </sw-alert>\n\n                    <sw-container>\n                        <sw-select-field :label=\"$t('areanet-clp.detail.typeLabel')\" v-model=\"entity.type\" :options=\"typeOptions\" :placeholder=\"$t('areanet-clp.detail.placeholder')\" :disabled=\"isDisabled\" required></sw-select-field>\n                        <sw-text-field :label=\"$t('areanet-clp.detail.nameLabel')\" v-model=\"entity.name\" :disabled=\"isDisabled\"></sw-text-field>\n                        <sw-text-field :label=\"$t('areanet-clp.detail.textLabel')\" v-model=\"entity.text\" :disabled=\"isDisabled\"></sw-text-field>\n                        <sw-container columns=\"auto 100px\" gap=\"0px 30px\">\n                            <sw-entity-single-select\n                                    v-model=\"entity.ghsId\"\n                                    entity=\"areanet_clp_ghs\"\n                                    :label=\"$t('areanet-clp.detail.symbolNameLabel')\"\n                                    :placeholder=\"$t('areanet-clp.detail.placeholder')\"\n                                    :disabled=\"isDisabled\"\n                                    :criteria=\"ghsAssignmentCriteria\"\n                                    @change=\"onSelectGhs\"\n                            ></sw-entity-single-select>\n                            <img v-if=\"entity.image\" :src=\"'../bundles/areanetclp/storefront/img/clp/' + entity.image\" :alt=\" entity.ghsalt\" width=\"80\" />\n                        </sw-container>\n                        <sw-select-field :label=\"$t('areanet-clp.detail.signalNameLabel')\" v-model=\"entity.signalName\" :options=\"signalOptions\" :placeholder=\"$t('areanet-clp.detail.placeholder')\" :disabled=\"isDisabled\"></sw-select-field>\n\n                    </sw-container>\n\n                    <sw-entity-many-to-many-select\n                            :localMode=\"entity.isNew()\"\n                            :label=\"$t('areanet-clp.detail.assignProductsLabel')\"\n                            v-model=\"entity.products\">\n                    </sw-entity-many-to-many-select>\n                </sw-card>\n            </sw-card-view>\n        </template>\n    </sw-page>\n{% endblock %}";