{% block sw_product_detail_base_settings_card %}
    {% parent() %}

    <sw-card :title="$t('sw-product.detail.areanetClpCardLabel')"
             :isLoading="isLoading"
             positionIdentifier="areanetClpCardLabel"
             v-if="(areanetClpSystemConfigValues.showAdminProductClpAssignment ?? false) === true"
    >
        <my-custom-many-to-many-select
                :localMode="product.isNew()"
                @change="getCustomFields"
                labelProperty="name"
                v-model="product.extensions.areanetClp"
                :placeholder="$t('sw-product.detail.areanetClpSelectPlaceholder')"
                :valueLimit="10"
                :label="$t('sw-product.detail.areanetClpSelectLabel')"
                :criteria="AreanetClpProductAssignmentCriteria"
        >

            <template #selection-label-property="{ item }">
                <img
                        v-if="item.ghs && item.ghs.image != null && item.ghs.image != ''"
                        :src="'../bundles/areanetclp/storefront/img/clp/' + item.ghs.image"
                        height="14"
                        style="height: 14px; float: left; padding-right: 5px;"
                />
                {{ item.name }}
            </template>

            <template #result-label-property="{ item }">
                <img
                        v-if="item.ghs && item.ghs.image != null && item.ghs.image != ''"
                        :src="'../bundles/areanetclp/storefront/img/clp/' + item.ghs.image"
                        width="40"
                />
                {{ item.name }} - {{ item.text }}
            </template>
        </my-custom-many-to-many-select>

        <sw-text-field
                v-for="(field,key) in textFields"
                :key ="key"
                v-model="product.customFields.areanet_clp[key]">
            <template slot="label">
                <span class="clp-label">
                    <img
                            v-if="field.item.ghs && field.item.ghs.image != null && field.item.ghs.image != ''"
                            :src="'../bundles/areanetclp/storefront/img/clp/' + field.item.ghs.image"
                            width="40"
                    />
                    <span v-else>&nbsp;</span>
                    <b>{{ field.label }}:</b>
                    <span>{{ field.text }}</span>
                </span>
            </template>
        </sw-text-field>
    </sw-card>
{% endblock %}